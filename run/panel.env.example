PANEL_AUTH_SECRET=change-me-panel-auth-secret
PANEL_PUBLIC_URL=http://localhost:3030
PANEL_PUBLIC_HOSTS=localhost,127.0.0.1
PANEL_USERS_FILE=/run-config/panel_users.json
PANEL_ADMIN_KEY=change-me-panel-admin-key
PANEL_API_ALLOWED_CIDRS=127.0.0.1/32,::1/128
PANEL_API_ALLOWED_SERVICE_NAMES=panel-web
# Optional single-user fallback if PANEL_USERS_FILE is missing:
# PANEL_USERNAME=admin
# PANEL_PASSWORD_HASH=scrypt$replace-with-generated-hash
FUTU_GATEWAY_BASE_URL=http://127.0.0.1:8080
# Postgres backing the paper-trading gateway read model.
PAPER_DB_URL=postgresql://aistock_app:change-me@postgres16:5432/aistock
PAPER_TRADING_BUDGET_TOTAL=200000
PAPER_TRADING_MAX_BUY_ORDER_QTY=100
PAPER_TRADING_MAX_SELL_ORDER_QTY=9999999999
PIPELINE_AUTO_RUN_ENABLED=1
PIPELINE_AUTO_RUN_TIMEZONE=Asia/Shanghai
PIPELINE_AUTO_RUN_TIME=18:00
PIPELINE_AUTO_RUN_POLL_SECONDS=60
US_SELECTION_AUTO_RUN_ENABLED=0
US_SELECTION_AUTO_RUN_POLL_SECONDS=60
US_SELECTION_PRICE_TIME=16:31
US_SELECTION_PRICE_BATCH_SIZE=55
US_SELECTION_PRICE_BATCH_SLEEP_SECONDS=60
US_SELECTION_AVERAGE_TIME=00:30
US_SELECTION_DETAILS_TIME=03:00
US_SELECTION_UNIVERSE_TIME=06:00
FINNHUB_API_KEY=
MASSIVE_API_KEY=
