#!/bin/bash
set -euo pipefail
dnf update -y
dnf install -y docker amazon-cloudwatch-agent
systemctl enable --now docker
curl -sfL https://get.k3s.io | sh -
mkdir -p /opt/aws/amazon-cloudwatch-agent/etc
cat >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'JSON'
{
  "agent": {"region": "${aws_region}"},
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {"file_path": "/var/log/messages", "log_group_name": "${log_group}", "log_stream_name": "{instance_id}/system"},
          {"file_path": "/var/lib/rancher/k3s/agent/containerd/containerd.log", "log_group_name": "${log_group}", "log_stream_name": "{instance_id}/k3s"}
        ]
      }
    }
  },
  "metrics": {"metrics_collected": {"mem": {"measurement": ["mem_used_percent"]}, "disk": {"measurement": ["used_percent"], "resources": ["/"]}}}
}
JSON
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
